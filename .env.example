# Public site URL for Open Graph / Twitter link previews (no trailing slash).
# Litepaper: {NEXT_PUBLIC_SITE_URL}/litepaper → https://aptcasino.fun/litepaper
NEXT_PUBLIC_SITE_URL=https://aptcasino.fun

# Investor pitch deck (Figma Slides) — used site-wide for links & litepaper embed
NEXT_PUBLIC_PITCH_DECK_URL=https://www.figma.com/deck/pQc6GTjM3a8sXqbuGHyu1Z

# --- Default play chain (Solana first in UI) ---
NEXT_PUBLIC_DEFAULT_PLAY_CHAIN=solana

# --- Solana (primary live play chain) ---
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_RPC_URL=
NEXT_PUBLIC_SOL_TREASURY_ADDRESS=
NEXT_PUBLIC_OTC_LOTTERY_SOL_WALLET=
SOL_TREASURY_SECRET_KEY=
NEXT_PUBLIC_PLATFORM_FEE_WALLET_SOL=
# Optional deposit caps (leave MAX empty for no limit; MIN empty = any amount with net credit > 0)
# SOLANA_MIN_DEPOSIT_SOL=
# SOLANA_MAX_DEPOSIT_SOL=
SOLANA_MIN_WITHDRAW_SOL=0.01
# Anchor program (apt_casino) — set after `npm run deploy:solana`
NEXT_PUBLIC_APT_CASINO_PROGRAM_ID=

# --- Aptos (secondary live play chain) ---
NEXT_PUBLIC_APTOS_NETWORK=mainnet
NEXT_PUBLIC_CASINO_MODULE_ADDRESS=
# House receive address for user deposits (defaults to module address if unset)
NEXT_PUBLIC_TREASURY_ADDRESS=
# Optional deposit/withdraw limits (defaults: min deposit 1 APT, min withdraw 1 APT)
# APTOS_MIN_DEPOSIT_APT=1
# APTOS_MAX_DEPOSIT_APT=
# APTOS_MIN_WITHDRAW_APT=1
# NEXT_PUBLIC_APTOS_MIN_DEPOSIT_APT=1
# NEXT_PUBLIC_APTOS_MIN_WITHDRAW_APT=1
# Operational treasury EOA private key (server only) — signs payouts & fee sweeps
# NEVER commit this value. If exposed in git, rotate immediately and move funds to a new key.
TREASURY_PRIVATE_KEY=
# Aptos Move publisher (same as treasury in typical single-account deploys)
DEPLOYER_PRIVATE_KEY=
# Separate fee collector (public address) — must differ from treasury in production
NEXT_PUBLIC_PLATFORM_FEE_WALLET_APT=
# Legacy alias supported by server
NEXT_PUBLIC_FEE_RECIPIENT=

# Wallet ownership proof for user-scoped API writes (production default: required)
# Set to false only for local dev without wallet signing
WALLET_AUTH_REQUIRED=true

# Server-side game payout verification (Solana/Aptos play ledger).
# When true (default), credit/settle ignores client payout amounts and derives outcomes from game_round + fairness proof.
GAME_PAYOUT_VERIFICATION_REQUIRED=true
# Safety cap on payout vs bet for pending-stake validation (default 2000 if unset)
# MAX_GAME_PAYOUT_MULTIPLIER=2000
# Disable public Aptos on-chain game_logger txs (recommended; saves treasury gas)
APTOS_ONCHAIN_GAME_LOG_ENABLED=false

# --- Platform economics (basis points: 1000 = 10%) ---
PLATFORM_FEE_BPS_DEPOSIT=1000
PLATFORM_FEE_BPS_WITHDRAW=1000
NEXT_PUBLIC_PLATFORM_FEE_BPS_DEPOSIT=1000
MANUAL_WITHDRAW_USD_THRESHOLD=50
# Max total auto-withdraw USD per wallet per 24h (split across multiple txns)
AUTO_WITHDRAW_DAILY_USD_CAP=50
# Max auto-withdraw per tx (above → manual approval in dashboard)
AUTO_WITHDRAW_MAX_SOL=0.1
AUTO_WITHDRAW_MAX_APT=1
# Max total auto-withdraw per wallet per 24h
AUTO_WITHDRAW_DAILY_MAX_SOL=0.1
AUTO_WITHDRAW_DAILY_MAX_APT=10

# Comma-separated emergency ban list (no DB migration required)
# BANNED_WALLET_ADDRESSES=

# Referrer share (bps of the gross first deposit). 2000 = 20% of deposit (paid in APTC).
REFERRER_FEE_SHARE_BPS_OF_DEPOSIT=2000
NEXT_PUBLIC_REFERRER_FEE_SHARE_BPS_OF_DEPOSIT=2000
# APTC referral unlock: 14-day cliff OR referee volume (USD) from play events
REFERRAL_APTC_CLIFF_DAYS=14
REFERRAL_REFEREE_VOLUME_UNLOCK_USD=100
APTC_USD_PRICE_OVERRIDE=
# Deposit APTC bonus (profile panel) — needs price when mint/DexScreener unset
DEPOSIT_APTC_BONUS_BPS=500
DEPOSIT_APTC_LOCK_DAYS=14
DEPOSIT_APTC_USD_FALLBACK=0.00000007

# --- GGR buyback (APTC) — % of GGR, split of buyback ---
GGR_BUYBACK_BPS_OF_GGR=3000
GGR_BURN_BPS_OF_BUYBACK=5000
GGR_STAKER_BPS_OF_BUYBACK=3500
GGR_TREASURY_BPS_OF_BUYBACK=1500
GGR_AVG_HOUSE_EDGE_BPS=250
# If CoinGecko is blocked, set a numeric fallback for USD thresholds
APT_USD_PRICE_OVERRIDE=

# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Optional new-format keys (publishable = anon, secret = service_role)
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# Secret for POST /api/withdraw/approve only (NOT for livestreams). When a user withdrawal is "pending" in Supabase,
# your ops tool sends: Authorization: Bearer <this exact value> with JSON { "requestId": "<uuid>" }.
# Generate once, e.g. `openssl rand -hex 32` — long random string, server-only, never commit.
WITHDRAW_APPROVAL_BEARER=

# --- Litepaper hero — optional community buttons (Telegram, Discord, X) ---
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_X_URL=https://x.com/aptcasinofun

# --- Live /streams (Livepeer + YouTube on /live) ---
# Server-only: Livepeer Studio metrics (viewers, etc.). Optional NEXT_PUBLIC_ alias supported by routes.
LIVEPEER_API_KEY=
NEXT_PUBLIC_LIVEPEER_API_KEY=
# Default: new streams are approved and visible immediately. Set to false for pre-moderation (then PATCH + admin bearer).
LIVE_STREAMS_AUTO_APPROVE=true
# Max streams stored per wallet (1–100).
LIVE_STREAMS_MAX_PER_WALLET=10
# Bearer token for PATCH /api/streams/[id] (approve/reject) and admin DELETE of any stream.
# Send header: Authorization: Bearer <LIVE_STREAMS_ADMIN_BEARER>. Unused if LIVE_STREAMS_AUTO_APPROVE=true.
LIVE_STREAMS_ADMIN_BEARER=

# --- House edge per game (basis points: 100 = 1.00%) ---
# Applied as: payout = bet * fair_multiplier * (1 - bps / 10000)
# Defaults are industry-standard. Leave blank to use defaults below.
#   plinko:   100 bps (1.00%)
#   mines:    300 bps (3.00%)
#   roulette: 0   bps (the single-zero European wheel already gives ~2.70% natural edge)
#   wheel:    400 bps (4.00%)
NEXT_PUBLIC_HOUSE_EDGE_BPS_PLINKO=100
NEXT_PUBLIC_HOUSE_EDGE_BPS_MINES=300
NEXT_PUBLIC_HOUSE_EDGE_BPS_ROULETTE=0
NEXT_PUBLIC_HOUSE_EDGE_BPS_WHEEL=400

# --- Demo / UI ---
NEXT_PUBLIC_DEMO_START_BALANCE_OCTAS=1000000000000000

# --- APTC token / launch (Virtuals Protocol · Robinhood Chain) ---
# Leave unset until the Virtuals agent token is created. "Live" UI needs DexScreener pair
# (or NEXT_PUBLIC_APTC_LAUNCHED=true) — not the contract address alone.
# NEXT_PUBLIC_APTC_TOKEN_ADDRESS=
# NEXT_PUBLIC_APTC_SOLANA_MINT=   # legacy alias — prefer APTC_TOKEN_ADDRESS
# NEXT_PUBLIC_APTC_DEXSCREENER_PAIR=
# NEXT_PUBLIC_APTC_LAUNCHED=false
NEXT_PUBLIC_APTC_STAKING_VAULT=2ei9VY2TtJ6GkvVMs1su5b348p98ajLaU45MzvE6gYaq
APTC_STAKING_ENABLED=false
NEXT_PUBLIC_APTC_STAKING_ENABLED=false

# --- APTC public IPO (DISABLED — Virtuals is the launch path) ---
# Do not publish mint / SOL collector / APTC distributor addresses until needed.
IPO_ENABLED=false
NEXT_PUBLIC_IPO_ENABLED=false
# NEXT_PUBLIC_IPO_SOL_TREASURY=
# NEXT_PUBLIC_IPO_APTC_DISTRIBUTOR=
# IPO_TREASURY_SECRET_KEY=
# SOL_STAKING_VAULT_SECRET_KEY=

# --- OTC lottery (SOL → APTC deal, 10-day lock) ---
OTC_LOTTERY_ENABLED=false
NEXT_PUBLIC_OTC_LOTTERY_ENABLED=false
# Lottery escrow — Solana wallet that receives OTC lottery SOL entries
NEXT_PUBLIC_OTC_LOTTERY_SOL_WALLET=
OTC_LOTTERY_MIN_SOL=2
OTC_LOTTERY_MAX_SOL=500
# Estimated swap platform fee (bps), e.g. 25 = 0.25% Phantom
OTC_LOTTERY_SWAP_FEE_BPS=25
# Estimated Raydium / DEX trade fee on APTC/SOL (bps), default 25 = 0.25%
OTC_LOTTERY_TOKEN_TAX_BPS=25
SOL_USD_PRICE_OVERRIDE=
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=
# Shared admin secret for dashboard + OTC lottery admin APIs + GGR buyback record.
# OTC routes accept OTC_LOTTERY_ADMIN_BEARER or fall back to DASHBOARD_ADMIN_TOKEN when unset.
OTC_LOTTERY_ADMIN_BEARER=
DASHBOARD_ADMIN_TOKEN=

# --- KOL partner allocations (0.1% supply = 1M APTC, 14-day lock) ---
# Per-KOL password portal at /kol/[slug]. Session cookie signing (optional; falls back to DASHBOARD_ADMIN_TOKEN).
KOL_PORTAL_SESSION_SECRET=
KOL_ALLOCATION_APTC=1000000
KOL_ALLOCATION_CLIFF_DAYS=14
KOL_ALLOCATION_LOCK_DAYS=14
# Optional: one-click export syncs all KOL rows to this Google Sheet (service account must be editor).
# Without these, export copies CSV to clipboard and opens sheets.new.
KOL_ALLOCATIONS_GOOGLE_SHEET_ID=
KOL_ALLOCATIONS_GOOGLE_SHEET_RANGE=Sheet1!A1
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# --- Daily login streak (profile → Daily streak panel) ---
# Set to false to hide streak UI and disable claims.
DAILY_STREAK_ENABLED=true
# APTC per day 1–7 (comma-separated). After day 7 the cycle restarts at day 1.
DAILY_STREAK_REWARDS_APTC=2,3,5,8,12,18,30

# --- Volume Cup (APTC entry fees + prizes) ---
# Requires NEXT_PUBLIC_APTC_SOLANA_MINT + NEXT_PUBLIC_PLATFORM_FEE_WALLET_SOL after TGE.
# Pre-launch: set entry fee to 0 in dashboard → Contests (free registration).

# --- Future chains (set status: live in src/lib/chains/registry.ts when wired) ---
NEXT_PUBLIC_SUI_TREASURY_ADDRESS=
NEXT_PUBLIC_PLATFORM_FEE_WALLET_SUI=
